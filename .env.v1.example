# Trident v1 — copy the relevant values into your root .env
# Never commit the real .env.

# --- Backend ---------------------------------------------------------------
# Required in production. Dev falls back to an insecure default.
JWT_SECRET=

# Required. The planner returns 503 without it.
ANTHROPIC_API_KEY=

# Optional. Google sign-in is hidden when these are absent; SIWE still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Where the frontend is served from. In production this is the Vercel URL —
# CORS is restricted to it and the OAuth callback redirects there.
FRONTEND_URL=http://localhost:5173

PORT=3001
NODE_ENV=development

# On Railway this must point at a mounted volume, or the DB is lost on redeploy.
DB_PATH=./trident.db

# --- Frontend (build-time, inlined by Vite) --------------------------------
# Backend origin. Leave empty for local dev, where Vite proxies to :3001.
# Required for a deployed frontend, e.g. https://trident-api.up.railway.app
VITE_API_BASE_URL=

# Optional. Without it, only injected wallets (MetaMask etc.) work — no
# WalletConnect QR. Only used for the "deposit from external wallet" flow.
VITE_WALLETCONNECT_PROJECT_ID=
