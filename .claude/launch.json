{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trident-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:probe",
        "-w",
        "@trident/node-backend"
      ],
      "port": 3001
    },
    {
      "name": "trident-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@trident/frontend"
      ],
      "port": 5173
    },
    {
      "name": "trident-frontend-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}
