{
  "name": "@trident/node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:e2e": "node --experimental-strip-types test/e2e.ts",
    "test:runner": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/runner.ts",
    "test:status": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/status.ts",
    "test": "npm run test:planner && npm run test:runner && npm run test:funding && npm run test:pathparams && npm run test:status && npm run test:e2e",
    "test:planner": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/planner.ts",
    "dev:probe": "STATUS_PROBER=on node --watch --experimental-strip-types src/server.ts",
    "test:pathparams": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/pathParams.ts",
    "test:funding": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/funding.ts",
    "test:circle": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/circleWallets.ts",
    "test:gateway-moves": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/gatewayMoves.ts",
    "circle:preflight": "node --experimental-strip-types scripts/circlePreflight.ts",
    "test:cross-package": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/crossPackage.ts",
    "test:account": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/accountRoutes.ts",
    "test:attribution": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/attribution.ts",
    "test:gas": "CIRCLE_API_KEY= CIRCLE_ENTITY_SECRET= CIRCLE_WALLET_SET_ID= node --experimental-strip-types test/gasSponsor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@circle-fin/adapter-viem-v2": "^1.12.1",
    "@circle-fin/bridge-kit": "^1.12.1",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "better-sqlite3": "^12.4.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^161.0.0",
    "jsonwebtoken": "^9.0.2",
    "ox": "^0.14.32",
    "siwe": "^3.0.0",
    "uuid": "^13.0.0",
    "viem": "^2.52.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.10",
    "typescript": "^5.7.3"
  }
}
